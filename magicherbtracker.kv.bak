#:kivy 2.3.0
#:import get_hex_from_color kivy.utils.get_hex_from_color
#:import KivyLabel kivy.uix.label.Label

<Theme@Widget>:
    dark_gray: 0.18, 0.122, 0.153, 1
    dark_green: 0.12, 0.172, 0.153, 1
    very_dark_green: 0.13, 0.15, 0.14, 1
    off_white:0.831, 0.875, 0.62, 1
    light_green: 0.773, 0.847, 0.427, 1
    nice_red: 0.827, 0.247, 0.286, 1
    nice_yellow: 1, 0.651, 0.188, 1
    light_yellow: 0.84, 0.68, 0.35, 1
    nice_orange: 0.945, 0.427, 0.196, 1
    nice_brown: 0.545, 0.325, 0.196, 1
    dark_brown: 0.345, 0.225, 0.146, 1
    bright_green: 0.196, 0.745, 0.325, 1
    nice_green: 0.289, 0.516, 0.353, 1 
    nice_blue: 0.235, 0.451, 0.686, 1 
    nice_purple: 0.392, 0.259, 0.416, 1
    black_transparent: 0, 0, 0, 0

    leaf_sativa: "res/svg/leaf_sativa.svg"
    leaf_indica: "res/svg/leaf_indica.svg"
    leaf_hybrid: "res/svg/leaf_hybrid.svg"

    bg_image: "res/img/background.png"
    font_logo_1: "res/fonts/Quicksand-Light.ttf"
    logo_size_1: "72sp"
    font_logo_2: "res/fonts/Quicksand-Bold.ttf"
    logo_size_2: "48sp"
    font_logo_3: "res/fonts/Quicksand-Regular.ttf"
    logo_size_3: "24sp"
    font_title: "res/fonts/Quicksand-Light.ttf"
    title_size: "32sp"
    font_subtitle: "res/fonts/SpaceGrotesk-Light.ttf"
    subtitle_size: "22sp"
    font_input: "res/fonts/Quicksand-Regular.ttf"
    input_size: "18sp"
    font_body: "res/fonts/SpaceGrotesk-Regular.ttf"
    body_size: "16sp"
    font_button: "res/fonts/Quicksand-Bold.ttf"
    small_size: "14sp"
    padding_zero: 0, 0, 0, 0
    padding_right: 0, 0, 20, 0
    padding_left:  20, 0, 0, 0
    padding_both: 20, 0, 20, 0
    padding_both_half: 10, 0, 10, 0
    padding_all: 20, 20, 20, 20
    padding_all_half: 10, 10, 10, 10
    
    array_4_10: 10, 10, 10, 10
    array_4_40: 40, 40, 20, 40
    array_4_100: 100, 100, 1000, 100
    array_4_200: 200, 200, 200, 200
    minimal_size: 1200, 800
    small_button: 0.12, 0.7
    med_button: 0.14, 0.8
    big_button: 0.24, 0.9


<App>:
    theme: Theme()

<Label>:
    font_name: app.theme.font_body
    color: app.theme.light_green
    font_size: app.theme.body_size

<ListLabel>:
    font_name: app.theme.font_body
    color: app.theme.light_green
    font_size: app.theme.body_size

<ListTitleLabel>:
    font_name: app.theme.font_subtitle
    color: app.theme.nice_yellow
    font_size: app.theme.subtitle_size

<ListSubLabel>:
    font_name: app.theme.font_subtitle
    color: app.theme.off_white
    font_size: app.theme.small_size

<LogoLabel1>:
    halign: "left"
    valign: "top"
    padding: app.theme.padding_left
    font_name: app.theme.font_logo_1
    font_size: app.theme.logo_size_1
    color: app.theme.nice_yellow
    text_size: self.size

<LogoLabel3>:
    halign: "left"
    valign: "top"
    padding: app.theme.padding_left
    font_name: app.theme.font_logo_3
    font_size: app.theme.logo_size_3
    color: app.theme.nice_yellow
    text_size: self.size

<Spinner>:
    background_color: app.theme.black_transparent
    color: app.theme.nice_yellow
    font_name: app.theme.font_logo_1
    font_size: app.theme.subtitle_size
    text_size: self.size
    valign: "middle"
    halign: "left"
    padding: 0
    canvas.before:
        Color:
            rgba: app.theme.black_transparent
        Rectangle:
            pos: self.pos
            size: self.size

<CustomDropdown>:
    background_color: app.theme.black_transparent
    color: app.theme.nice_yellow
    font_name: app.theme.font_title
    font_size: app.theme.subtitle_size
    text_size: self.size
    valign: "middle"
    halign: "left"
    padding: 0
    canvas.before:
        Color:
            rgba: app.theme.black_transparent
        Rectangle:
            pos: self.pos
            size: self.size

<SelectorDropdown>:
    background_color: app.theme.black_transparent
    color: app.theme.nice_yellow
    font_name: app.theme.font_logo_1
    font_size: app.theme.subtitle_size
    text_size: self.size
    valign: "middle"
    halign: "left"
    padding: 0
    canvas.before:
        Color:
            rgba: app.theme.black_transparent
        Rectangle:
            pos: self.pos
            size: self.size
        

<LogoLabel2>:
    halign: "left"
    valign: "bottom"
    padding: app.theme.padding_left
    font_name: app.theme.font_logo_2
    font_size: app.theme.logo_size_2
    color: app.theme.off_white
    text_size: self.size

<TitleLabel>:
    halign: "left"
    valign: "middle"
    markup: True
    highlight_color: get_hex_from_color(app.theme.off_white)
    font_name: app.theme.font_title
    font_size: app.theme.title_size
    color: app.theme.nice_yellow
    canvas.before:
        PushMatrix
        Rotate:
            angle: root.angle
            origin: self.center
    canvas.after:
        PopMatrix


<NutrientLabel>:
    halign: "right"
    valign: "middle"
    markup: True
    padding: 0
    font_name: app.theme.font_subtitle
    font_size: app.theme.subtitle_size
    color: app.theme.nice_green
    text_size: self.size

<FieldLabel>:
    halign: "right"
    valign: "middle"
    markup: True
    padding: app.theme.padding_right
    font_name: app.theme.font_subtitle
    font_size: app.theme.subtitle_size
    color: app.theme.nice_yellow
    text_size: self.size

<HintLabel>:
    halign: "right"
    valign: "bottom"
    markup: True
    padding: app.theme.padding_both_half
    font_name: app.theme.font_subtitle
    font_size: app.theme.body_size
    color: app.theme.nice_yellow
    text_size: self.size

<PromptLabel>:
    halign: "left"
    valign: "middle"
    padding: 0
    font_name: app.theme.font_subtitle
    font_size: app.theme.body_size 
    color: app.theme.off_white
    text_size: self.size

<WarningTitleLabel>:
    halign: "left"
    valign: "top"
    padding: app.theme.padding_all
    font_name: app.theme.font_title
    font_size: app.theme.body_size 
    color: app.theme.nice_yellow
    text_size: self.size

<WarningLabel>:
    halign: "left"
    valign: "middle"
    markup: True
    padding: app.theme.padding_left
    font_name: app.theme.font_subtitle
    font_size: app.theme.small_size 
    color: app.theme.light_yellow
    text_size: self.size
    canvas.before:
        Color:
            rgba: app.theme.black_transparent
        Rectangle:
            pos: self.pos
            size: self.size

<RedBox>:
    padding: app.theme.padding_zero
    canvas:
        Color:
            rgba: app.theme.nice_red
        Rectangle:
            pos: self.pos
            size: self.size

<YellowBox>:
    padding: app.theme.padding_zero
    canvas:
        Color:
            rgba: app.theme.nice_yellow
        Rectangle:
            pos: self.pos
            size: self.size


<GreenBox>:
    padding: app.theme.padding_zero
    canvas:
        Color:
            rgba: app.theme.nice_green
        Rectangle:
            pos: self.pos
            size: self.size

<DarkBox>:
    padding: app.theme.padding_zero
    canvas:
        Color:
            rgba: app.theme.very_dark_green
        Rectangle:
            pos: self.pos
            size: self.size

<LightBox>:
    padding: app.theme.padding_zero
    canvas:
        Color:
            rgba: app.theme.light_green
        Rectangle:
            pos: self.pos
            size: self.size

<EventBox>:
    canvas.before:
        Color:
            rgba: root.hover_bg_color if root.hovered else root.normal_bg_color
        Rectangle:
            pos: self.pos
            size: self.size


<BoxLayout>:
    spacing: 0

<ContentBox>:
    padding: app.theme.padding_zero
    spacing:0
    canvas.before:
        Color:
            rgba: app.theme.black_transparent
        Rectangle:
            pos: self.pos
            size: self.size

<TitleBox>:
    padding: app.theme.padding_zero
    spacing: 40
    canvas.before:
        Color:
            rgba: app.theme.black_transparent
        Rectangle:
            pos: self.pos
            size: self.size

<WrapperBox>:
    padding: app.theme.padding_zero
    canvas.before:
        Color:
            rgba: app.theme.black_transparent
        Rectangle:
            pos: self.pos
            size: self.size

<SpacerBox>:
    padding: app.theme.padding_zero
    canvas.before:
        Color:
            rgba: app.theme.black_transparent
        Rectangle:
            pos: self.pos
            size: self.size

<SelectableEventBox>:
    canvas.before:
        Color:
            rgba: root.selected_bg_color if root.selected else root.normal_bg_color
        Rectangle:
            pos: self.pos
            size: self.size      

<TextInput>:
    background_normal: ""
    background_active: ""
    border: 0, 1, 0, 0
    background_color: app.theme.black_transparent
    foreground_color: app.theme.off_white
    hint_text_color: app.theme.nice_green
    hint_text_size: app.theme.body_size
    font_name: app.theme.font_input
    font_name_hint_text: app.theme.font_subtitle
    selection_color: app.theme.nice_green
    cursor_color: app.theme.nice_green
    font_size: app.theme.body_size
    halign: "left"
    padding_x: 10
    padding_y: (self.height - self.line_height) / 2
    text_size: self.size
<LargeTextInput>:
    background_normal: ""
    background_active: ""
    border: 0, 1, 0, 0
    background_color: app.theme.black_transparent
    foreground_color: app.theme.off_white
    hint_text_color: app.theme.nice_green
    hint_text_size: app.theme.body_size
    font_name: app.theme.font_input
    font_name_hint_text: app.theme.font_subtitle
    selection_color: app.theme.nice_green
    cursor_color: app.theme.nice_green
    font_size: app.theme.body_size
    halign: "left"
    padding_x: 10
    # For multi-line inputs, use small vertical padding; for single-line, center text vertically
    padding_y: 10 if self.multiline else (self.height - (self.line_height * self.font_size)) / 2
    text_size: self.size
    
<HoverButton>:
    canvas.before:
        Color:
            rgba: root.hover_background_color if root.hovered else root.background_color
        Rectangle:
            pos: self.pos
            size: self.size

<HoverToggle>:
    canvas.before:
        Color:
            rgba: root.hover_background_color if (root.hovered and root.state == 'normal') else root.background_color
        Rectangle:
            pos: self.pos
            size: self.size

<Button>:
    background_normal: ""
    background_down: ""
    background_color: app.theme.dark_green
    color: app.theme.nice_green
    font_name: app.theme.font_button
    font_size: app.theme.input_size
    on_state:
        self.background_color = app.theme.dark_green if self.state == "normal" else app.theme.nice_green
        self.color = app.theme.nice_green if self.state == "normal" else app.theme.dark_green

<ButtonGreen>:
    background_normal: ""
    background_down: ""
    background_color: app.theme.nice_green
    color: app.theme.dark_gray
    font_name: app.theme.font_button
    font_size: app.theme.input_size
    on_state:
        self.background_color = app.theme.nice_green if self.state == "normal" else app.theme.nice_yellow
        self.color = app.theme.dark_gray if self.state == "normal" else app.theme.nice_green

<ButtonYellow>:
    background_normal: ""
    background_down: ""
    background_color: app.theme.nice_yellow
    color: app.theme.dark_gray
    font_name: app.theme.font_button
    font_size: app.theme.input_size
    on_state:
        self.background_color = app.theme.nice_yellow if self.state == "normal" else app.theme.nice_yellow
        self.color = app.theme.dark_gray if self.state == "normal" else app.theme.nice_yellow


<ButtonRed>:
    background_normal: ""
    background_down: ""
    background_color: app.theme.nice_red
    color: app.theme.dark_gray
    font_name: app.theme.font_button
    font_size: app.theme.input_size
    on_state:
        self.background_color = app.theme.nice_red if self.state == "normal" else app.theme.nice_yellow
        self.color = app.theme.dark_gray if self.state == "normal" else app.theme.nice_red

<ButtonBllue>:
    background_normal: ""
    background_down: ""
    background_color: app.theme.nice_blue
    color: app.theme.dark_gray
    font_name: app.theme.font_button
    font_size: app.theme.input_size
    on_state:
        self.background_color = app.theme.nice_blue if self.state == "normal" else app.theme.nice_yellow
        self.color = app.theme.dark_gray if self.state == "normal" else app.theme.nice_blue

<ButtonPurple>:
    background_normal: ""
    background_down: ""
    background_color: app.theme.nice_purple
    color: app.theme.dark_gray
    font_name: app.theme.font_button
    font_size: app.theme.input_size
    on_state:
        self.background_color = app.theme.nice_purple if self.state == "normal" else app.theme.nice_yellow
        self.color = app.theme.dark_gray if self.state == "normal" else app.theme.nice_purple

<ButtonTransparent>:
    background_normal: ""
    background_down: ""
    background_color: app.theme.black_transparent
    color: app.theme.nice_yellow
    font_name: app.theme.font_title
    font_size: app.theme.input_size
    halign: "left"
    valign: "middle"
    text_size: self.size
    padding: app.theme.padding_left
    on_state:
        self.background_color = app.theme.black_transparent if self.state == "normal" else app.theme.nice_yellow
        self.color = app.theme.nice_yellow if self.state == "normal" else app.theme.dark_gray

<ToggleButton>:
    width: 200
    background_normal: ""
    background_down: ""
    background_color: app.theme.black_transparent
    color: app.theme.nice_yellow
    font_name: app.theme.font_button
    font_size: app.theme.input_size
    size_hint: app.theme.small_button
    on_state:
        self.background_color = app.theme.black_transparent if self.state == "normal" else app.theme.nice_yellow
        self.color = app.theme.nice_yellow if self.state == "normal" else app.theme.dark_gray

<ButtonDarkGreen>:
    background_normal: ""
    background_down: ""
    background_color: app.theme.dark_green
    color: app.theme.off_white
    font_name: app.theme.font_title
    font_size: app.theme.input_size
    size_hint: app.theme.small_button
    halign: "left"
    valign: "middle"
    text_size: self.size
    padding: app.theme.padding_left
    on_state:
        self.background_color = app.theme.dark_green if self.state == "normal" else app.theme.nice_green
        self.color = app.theme.off_white if self.state == "normal" else app.theme.dark_gray

<NutrientButton>:
    background_normal: ""
    background_down: ""
    background_color: app.theme.nice_green
    color: app.theme.dark_gray
    font_name: app.theme.font_button
    font_size: app.theme.subtitle_size
    size_hint_x: 1
    on_state:
        self.background_color = app.theme.nice_green if self.state == "normal" else app.theme.nice_yellow
        self.color = app.theme.dark_gray if self.state == "normal" else app.theme.nice_green

<GraphButton>:
    background_normal: ""
    background_down: ""
    font_name: app.theme.font_title
    font_size: app.theme.body_size

<ResetButton>:
    background_normal: ""
    background_down: ""
    background_color: app.theme.nice_green
    color: app.theme.dark_gray
    font_name: app.theme.font_button
    font_size: app.theme.subtitle_size
    size_hint_x: 1
    on_state:
        self.background_color = app.theme.nice_green if self.state == "normal" else app.theme.nice_green
        self.color = app.theme.dark_gray if self.state == "normal" else app.theme.dark_gray

<SuggestionButton>:
    background_normal: ""
    background_down: ""
    background_color: app.theme.nice_green
    color: app.theme.off_white
    font_name: app.theme.font_input
    font_size: app.theme.body_size
    size_hint_y: None
    height: "28dp"
    halign: "left"
    valign: "middle"
    text_size: self.size
    padding: app.theme.padding_left

<Slider>:
    cursor_size: app.theme.subtitle_size, app.theme.subtitle_size
    cursor_image: ""
    canvas.before:
        Color:
            rgba: app.theme.nice_red
        Rectangle:
            size: self.cursor_size
            pos: self.x + self.value_normalized * self.width - self.cursor_size[0] / 2, self.center_y - self.cursor_size[1] / 2
    canvas.after:
        Color:
            rgba: app.theme.nice_yellow
        Rectangle:
            size: self.cursor_size
            pos: self.x + self.value_normalized * self.width - self.cursor_size[0] / 2, self.center_y - self.cursor_size[1] / 2

<TabbedPanel>:
    background_color: app.theme.black_transparent
    tab_height: 40
    tab_width: 200
    do_default_tab: False
    text_color: app.theme.nice_yellow
    background_normal: ""
    background_down: ""
    border: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: app.theme.black_transparent if not self._current_tab else app.theme.nice_yellow


<TabbedPanelContent>:
    # remove default style padding to eliminate gap below tabs
    padding: 0

<TabbedPanelStrip>:
    # reduce strip padding so tabs sit closer to content
    padding: 0

<Graph>:
    line_width: 2
    background_color: app.theme.black_transparent
    color: app.theme.nice_yellow
    border_color: app.theme.black_transparent
    xlabel_color: app.theme.off_white
    ylabel_color: app.theme.off_white
    tick_color: app.theme.black_transparent
    grid_color: app.theme.black_transparent
    label_options: {'font_name': app.theme.font_subtitle, 'font_size': app.theme.small_size}
    padding: 5
    canvas.before:
        Color:
            rgba: app.theme.black_transparent
        Rectangle:
            pos: self.pos
            size: self.size

<PlantListView>:
    viewclass: "PlantListItem"
    SelectableRecycleBoxLayout:
        default_size: None, dp(80)
        default_size_hint: 1, None
        size_hint_y: None
        height: self.minimum_height
        orientation: "vertical"

<PlantListItem@SelectableBoxLayout>:
    orientation: "horizontal"
    size_hint_y: None
    height: "120dp"

    genes: ""
    name: ""
    strain: ""
    notes: ""
    medium: ""
    last_watering: ""
    next_watering: ""
    flower_status: ""
    harvest_status: ""

    canvas.before:
        Color:
            rgba: app.theme.nice_purple if root.selected else app.theme.black_transparent
        Rectangle:
            pos: self.pos
            size: self.size

    # left: type icon 
    ItemBox:
        size_hint_x: 0.1
        LeafIcon:
            source:
                app.theme.leaf_sativa if root.genes == "Sativa" else \
                app.theme.leaf_indica if root.genes == "Indica" else \
                app.theme.leaf_hybrid if root.genes == "Hybrid" else ""
    # middle: name / strain / notes
    ItemBox:
        orientation: "vertical"
        size_hint_x: 0.5
        color: app.theme.nice_yellow if root.selected else app.theme.black_transparent
        ListSubLabel:
            text: root.name
            halign: "left"
            valign: "bottom"
            padding: app.theme.padding_left
            text_size: self.size
        ListTitleLabel:
            text: root.strain
            halign: "left"
            valign: "middle"
            padding: app.theme.padding_left
            text_size: self.size
        ListLabel:
            text: root.notes
            halign: "left"
            valign: "top"
            padding: app.theme.padding_left
            text_size: self.size

    # medium
    ItemBox:
        size_hint_x: 0.10
        color: app.theme.nice_yellow if root.selected else app.theme.black_transparent
        ListLabel:
            text: root.medium
            halign: "center"
            valign: "middle"
            text_size: self.size

    # last watering
    ItemBox:
        size_hint_x: 0.11
        color: app.theme.nice_yellow if root.selected else app.theme.black_transparent
        ListLabel:
            text: root.last_watering
            halign: "center"
            valign: "middle"
            text_size: self.size
            
    # next watering
    ItemBox:
        size_hint_x: 0.13
        color: app.theme.nice_yellow if root.selected else app.theme.black_transparent
        ListLabel:
            text: root.next_watering
            halign: "center"
            valign: "middle"
            text_size: self.size



    # flower / harvest
    ItemBox:
        size_hint_x: 0.14
        color: app.theme.nice_yellow if root.selected else app.theme.black_transparent
        ListLabel:
            text: root.flower_status
            halign: "center"
            valign: "middle"
            text_size: self.size

    ItemBox:
        size_hint_x: 0.14
        color: app.theme.nice_yellow if root.selected else app.theme.black_transparent
        ListLabel:
            text: root.harvest_status
            halign: "center"
            valign: "middle"
            text_size: self.size

<GardenListView>:
    viewclass: "GardenListItem"
    SelectableRecycleBoxLayout:
        default_size: None, dp(80)
        default_size_hint: 1, None
        size_hint_y: None
        height: self.minimum_height
        orientation: "vertical"

<GardenListItem@SelectableBoxLayout>:
    orientation: "horizontal"
    size_hint_y: None
    height: "80dp"

    garden_id: ""
    garden_name: ""
    garden_type: ""
    plant_count: ""

    canvas.before:
        Color:
            rgba: app.theme.nice_purple if root.selected else app.theme.black_transparent
        Rectangle:
            pos: self.pos
            size: self.size

    ItemBox:
        size_hint_x: 0.5
        ListTitleLabel:
            text: root.garden_name
            halign: "left"
            valign: "middle"
            padding: app.theme.padding_left
            text_size: self.size

    ItemBox:
        size_hint_x: 0.2
        ListLabel:
            text: root.garden_type
            halign: "center"
            valign: "middle"
            text_size: self.size

    ItemBox:
        size_hint_x: 0.2
        ListLabel:
            text: root.plant_count
            halign: "center"
            valign: "middle"
            text_size: self.size

    SpacerBox:
        size_hint_x: 0.1
       